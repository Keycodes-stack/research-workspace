# Base URL of the Go gateway (the browser talks only to the gateway, never to the AI service directly).
# This is the ONLY place you need to change to switch between local and VPS backend.
#
# Local development:
# NEXT_PUBLIC_API_URL=http://localhost:8080
#
# VPS / production:
# NEXT_PUBLIC_API_URL=https://your-vps-domain.sslip.io
NEXT_PUBLIC_API_URL=
