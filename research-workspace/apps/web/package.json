    "@tiptap/starter-kit": "^2.27.3",
    "@untitledui/icons": "0.0.23",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
