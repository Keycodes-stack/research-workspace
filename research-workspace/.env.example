POSTGRES_USER=rw
POSTGRES_PASSWORD=rw_dev_password
POSTGRES_DB=research_workspace
DATABASE_URL=postgresql://rw:rw_dev_password@localhost:5432/research_workspace

REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=research-pdfs
S3_REGION=us-east-1

MISTRAL_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
# Any other OpenAI-compatible service (an aggregator such as xKiro or OpenRouter, Together, DeepSeek ...):
# its API address (ends in /v1) and key; then MODEL_<slot>_PROVIDER=compat and MODEL_<slot>_NAME as that
# service names the model, e.g. MODEL_B_NAME=mistralai/mistral-small-2603.
COMPAT_BASE_URL=
COMPAT_API_KEY=

# Models: set a provider and a model name for each of A and B. Either can use
# mistral | groq | gemini | ollama | compat; use different vendors so the two checks stay independent.
# mistral and groq are CLOUD APIs: chunk text (including confidential Mode B
# documents) is sent to them. Use ollama on both for fully local processing.
# Pin an explicit Mistral model version below if "latest" aliases may drift.
MODEL_A_PROVIDER=mistral
MODEL_A_NAME=mistral-small-latest
MODEL_B_PROVIDER=groq
MODEL_B_NAME=llama-3.1-8b-instant
OLLAMA_BASE_URL=http://localhost:11434/v1

# Shared by the Go gateway and the AI service (16+ chars). Generate with:
#   openssl rand -hex 32
# Max source-text tokens sent to a model per question (0 = unlimited). Lowest-ranked passages are dropped first.
# Keeps requests under provider per-minute caps (Groq free tier: 8,000).
LLM_CONTEXT_TOKEN_BUDGET=4500

INTERNAL_TOKEN=

# Gateway only (JWT_SECRET must be 32+ chars; tokens come from your identity provider)
JWT_SECRET=
AI_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Contact email for OpenAlex / Unpaywall polite pools
CONTACT_EMAIL=

# bge = real semantic model (needs requirements-ml.txt). hash = keyword hashing, tests/dev only.
EMBEDDER=bge
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
MAX_PDF_MB=50
EMBEDDING_DIM=768
SIMILARITY_THRESHOLD=0.65
# Citation verifier
FUZZY_THRESHOLD=0.9
MIN_QUOTE_TOKENS=3
MIN_SUPPORT=0.7
STRICT_NUMBERS=true
CHUNK_TOKENS=512
CHUNK_OVERLAP=64
