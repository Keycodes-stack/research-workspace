POSTGRES_USER=rw
POSTGRES_PASSWORD=rw_dev_password
POSTGRES_DB=research_workspace
DATABASE_URL=postgresql://rw:rw_dev_password@localhost:5432/research_workspace

REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=research-pdfs
S3_REGION=us-east-1

MISTRAL_API_KEY=
GROQ_API_KEY=
MISTRAL_MODEL=mistral-small-latest
LLAMA_MODEL=llama-3.1-8b-instant

# Model providers. A: mistral | ollama. B: groq | ollama.
# mistral and groq are CLOUD APIs: chunk text (including confidential Mode B
# documents) is sent to them. Use ollama on both for fully local processing.
# Pin an explicit Mistral model version below if "latest" aliases may drift.
MODEL_A_PROVIDER=mistral
MODEL_B_PROVIDER=groq
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL_A=mistral-small:24b
OLLAMA_MODEL_B=llama3.1:8b

# Shared by the Go gateway and the AI service (16+ chars). Generate with:
#   openssl rand -hex 32
INTERNAL_TOKEN=

# Gateway only (JWT_SECRET must be 32+ chars; tokens come from your identity provider)
JWT_SECRET=
AI_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Contact email for OpenAlex / Unpaywall polite pools
CONTACT_EMAIL=

EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
MAX_PDF_MB=50
EMBEDDING_DIM=768
SIMILARITY_THRESHOLD=0.76
# Citation verifier
FUZZY_THRESHOLD=0.9
MIN_QUOTE_TOKENS=3
MIN_SUPPORT=0.7
STRICT_NUMBERS=true
CHUNK_TOKENS=512
CHUNK_OVERLAP=64
